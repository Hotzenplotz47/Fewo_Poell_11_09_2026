# Apache-Einstellungen fuer www.ferienwohnung-poell.de (All-inkl)

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# Kein Verzeichnislisting
Options -Indexes

# Alles auf https://www.ferienwohnung-poell.de umleiten.
# SSL-Zertifikat ist im KAS aktiv (Stand 27.10.2026).
RewriteEngine On
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^ https://www.ferienwohnung-poell.de%{REQUEST_URI} [R=301,L]

# Alte TYPO3-Adressen auf die Startseite schicken, damit Lesezeichen
# und Google-Treffer nicht im Leeren landen
RewriteRule ^index\.php$ / [R=301,L]
RewriteRule ^ferienwohnung-poell/(ferienwohnung|appartement)/?$ /#wohnungen [R=301,NE,L]
RewriteRule ^ferienwohnung-poell/umgebung/?$ /#umgebung [R=301,NE,L]
RewriteRule ^ferienwohnung-poell/(kontakt|lage)/?$ /#anfrage [R=301,NE,L]
RewriteRule ^ferienwohnung-poell/impressum/?$ /impressum.html [R=301,L]
RewriteRule ^ferienwohnung-poell/datenschutz/?$ /datenschutz.html [R=301,L]
RewriteRule ^ferienwohnung-poell(/.*)?$ / [R=301,L]
# Beide Domains zeigten früher dasselbe TYPO3, daher auch die Adressen
# des anderen Hauses auf dessen neue Domain schicken
RewriteRule ^landhaus-wackerl(/.*)?$ https://www.landhaus-wackerl.de/ [R=301,L]

# Browser sollen Bilder, Schriften und das Stylesheet zwischenspeichern
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
</IfModule>
