# Apache-Einstellungen fuer www.ferienwohnung-poell.de (All-inkl)

# Eigene Fehlerseite
ErrorDocument 404 /404.html

# Kein Verzeichnislisting
Options -Indexes

# Alles auf https://www.ferienwohnung-poell.de umleiten.
# Erst aktivieren, wenn im KAS das SSL-Zertifikat fuer die Domain
# eingeschaltet ist – sonst laeuft die Seite in eine Fehlermeldung.
# Dann bei den naechsten drei Zeilen das # am Anfang entfernen.
RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\. [NC]
# RewriteRule ^ https://www.ferienwohnung-poell.de%{REQUEST_URI} [R=301,L]

# Alte TYPO3-Adressen auf die Startseite schicken, damit Lesezeichen
# und Google-Treffer nicht im Leeren landen
RewriteRule ^index\.php$ / [R=301,L]

# Browser sollen Bilder, Schriften und das Stylesheet zwischenspeichern
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
</IfModule>
